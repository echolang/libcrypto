use crypto::{blake2b, Blake2b, hex};

// RFC 7693 appendix A, plus vectors from libsodium's crypto_generichash

test blake2b_rfc7693_abc
{
    assert(hex(blake2b('abc', 64)) == 'ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923');
}

test blake2b_empty_default_size
{
    assert(hex(blake2b('')) == '0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8');
}

test blake2b_keyed
{
    string $key = str::repeat('k', 32);

    assert(hex(blake2b(key: $key, 'the message')) == 'c42f1d20f4bd9616c6b28f368f49bfa7051664346d7e666637ae97e7cc76a0de');
}

test blake2b_incremental_matches_one_shot
{
    Blake2b $hasher = Blake2b();
    usize $i = 0;

    // 1000 bytes in uneven pieces, across several 128 byte blocks
    while ($i < 40) {
        $hasher->update('aaaaaaaaaaaaaaaaaaaaaaaaa');
        $i = $i + 1;
    }

    assert(hex($hasher->finish()) == 'e00b0ddbf1e2cdaf5c898e1a5e8826ea3a2c339bcf2a478da2e5fca9ff126672');

    // finish resets, so the next message starts clean
    $hasher->update('abc');
    assert($hasher->finish() == blake2b('abc'));
}

test blake2b_incremental_keyed
{
    string $key = str::repeat('k', 32);
    Blake2b $mac = Blake2b(key: $key);

    $mac->update('the ');
    $mac->update('message');
    assert(hex($mac->finish()) == 'c42f1d20f4bd9616c6b28f368f49bfa7051664346d7e666637ae97e7cc76a0de');
}
