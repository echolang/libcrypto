use crypto::{hmacSha256, hmacSha1, hex};

// RFC 4231 test cases, keys and data given as hex

private function mac(const string& $keyHex, const string& $dataHex) : string
{
    return hex(hmacSha256(raw($keyHex), raw($dataHex)));
}

test hmac_case_1
{
    assert(mac(str::repeat('0b', 20), '4869205468657265') == 'b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7');
}

test hmac_case_2
{
    assert(mac('4a656665', '7768617420646f2079612077616e7420666f72206e6f7468696e673f') == '5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843');
}

test hmac_case_3
{
    assert(mac(str::repeat('aa', 20), str::repeat('dd', 50)) == '773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe');
}

test hmac_case_4
{
    string $key = '0102030405060708090a0b0c0d0e0f10111213141516171819';

    assert(mac($key, str::repeat('cd', 50)) == '82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b');
}

test hmac_case_6_long_key
{
    string $data = '54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374';

    assert(mac(str::repeat('aa', 131), $data) == '60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54');
}

test hmac_case_7_long_key_and_data
{
    string $data = '';

    assert(mac(str::repeat('aa', 131), $data) == '9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2');
}

// RFC 2202 HMAC-SHA1 test cases

private function mac1(const string& $keyHex, const string& $dataHex) : string
{
    return hex(hmacSha1(raw($keyHex), raw($dataHex)));
}

test hmac_sha1_case_1
{
    assert(mac1(str::repeat('0b', 20), '4869205468657265') == 'b617318655057264e28bc0b6fb378c8ef146be00');
}

test hmac_sha1_case_2
{
    assert(mac1('4a656665', '7768617420646f2079612077616e7420666f72206e6f7468696e673f') == 'effcdf6ae5eb2fa2d27416d5f184df9c259a7c79');
}

test hmac_sha1_case_6_long_key
{
    string $data = '54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374';

    assert(mac1(str::repeat('aa', 80), $data) == 'aa4ae5e15272d00e95705637ce8a3b55ed402112');
}
