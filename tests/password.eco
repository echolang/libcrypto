use crypto::{hashPassword, verifyPassword, needsRehash, PasswordCost, PasswordError};

// the encoded hashes were made by PHP's password_hash(PASSWORD_ARGON2ID),
// which is the libargon2 reference implementation underneath

test verifies_php_default_hash
{
    string $php = '$argon2id$v=19$m=65536,t=4,p=1$TEhCaWx0NnJIanRlMFNqag$POY0HbvI6PvZBdV6igpM6a6SU+NEyQvpbxxBDKRiDK4';

    assert(verifyPassword('correct horse battery staple', $php));
    assert(!verifyPassword('correct horse battery stapler', $php));
}

test verifies_php_small_hashes
{
    assert(verifyPassword('hunter2', '$argon2id$v=19$m=1024,t=2,p=1$T0w5WHBXQlR1LzdpdmguMQ$18AC3XhBn0ij9P0ftzaLat3Z8TiylPG3Hd3TeqgOhOw'));
    assert(verifyPassword('', '$argon2id$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
}

test verifies_php_four_lanes
{
    assert(verifyPassword('lanes', '$argon2id$v=19$m=1024,t=2,p=4$ZUc3UlZPMUNRYWkyeEhFcA$hzvSxyxBcGz11nynmGJrRJu8Oe7uXoicwlyEJC01IIc'));
}

test hash_then_verify
{
    PasswordCost $cheap = PasswordCost(1024, 1);
    string $a = guard hashPassword('s3cret', $cheap);
    string $b = guard hashPassword('s3cret', $cheap);

    assert($a->starts('$argon2id$v=19$m=1024,t=1,p=1$'));
    assert($a != $b);
    assert(verifyPassword('s3cret', $a));
    assert(verifyPassword('s3cret', $b));
    assert(!verifyPassword('s3creT', $a));
}

test standard_cost_round_trip
{
    string $encoded = guard hashPassword('pw');

    assert($encoded->starts('$argon2id$v=19$m=65536,t=3,p=1$'));
    assert(verifyPassword('pw', $encoded));
    assert(!needsRehash($encoded));
    assert(needsRehash($encoded, PasswordCost(131072, 3)));
}

test rejects_malformed
{
    string $good = '$argon2id$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI';

    assert(verifyPassword('', $good));
    assert(!verifyPassword('', ''));
    assert(!verifyPassword('', 'plaintext'));
    // argon2i and argon2d are not argon2id
    assert(!verifyPassword('', '$argon2i$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    assert(!verifyPassword('', '$argon2id$v=16$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    // hex numbers, missing params, silly costs
    assert(!verifyPassword('', '$argon2id$v=19$m=0x100,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    assert(!verifyPassword('', '$argon2id$v=19$m=256,t=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    assert(!verifyPassword('', '$argon2id$v=19$m=999999999,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    assert(!verifyPassword('', '$argon2id$v=19$m=256,t=0,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMI'));
    // bad base64, a trailing character with stray bits, a truncated hash
    assert(!verifyPassword('', '$argon2id$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PM!'));
    assert(!verifyPassword('', '$argon2id$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn6rRtLCitkYKyhx2ovwJpG42+PMJ'));
    assert(!verifyPassword('', '$argon2id$v=19$m=256,t=1,p=1$elJUMTJURXFPU2VsaGJKYQ$TYC7RNbTzIvJKxQn'));
    assert(needsRehash('garbage'));
}

test rejects_bad_cost
{
    $r = hashPassword('x', PasswordCost(4, 1));

    assert($r->failed());
    assert(match ($r->failure()) {
        PasswordError::badCost => true,
        else => false,
    });
}
