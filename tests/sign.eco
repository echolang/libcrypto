use crypto::{SigningKey, verify, hex};

// RFC 8032 section 7.1, tests 1 and 2 (libsodium agrees byte for byte)

test ed25519_rfc8032_test_1
{
    SigningKey $key = guard SigningKey::restore(raw('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60'));
    string $sig = $key->sign('');

    assert(hex($key->publicKey()) == 'd75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a');
    assert(hex($sig) == 'e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b');
    assert(verify($key->publicKey(), '', $sig));
}

test ed25519_rfc8032_test_2
{
    SigningKey $key = guard SigningKey::restore(raw('4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb'));
    string $message = raw('72');

    assert(hex($key->publicKey()) == '3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c');
    assert(hex($key->sign($message)) == '92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00');
}

test ed25519_verify_only_needs_the_public_key
{
    string $public = raw('3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c');
    string $sig = raw('92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00');

    assert(verify($public, raw('72'), $sig));
    assert(!verify($public, raw('73'), $sig));
    assert(!verify($public, '', $sig));
}

test ed25519_generate_sign_verify
{
    SigningKey $key = guard SigningKey::generate();
    string $sig = $key->sign('hello');

    assert($key->seed()->size() == 32);
    assert($sig->size() == 64);
    assert(verify($key->publicKey(), 'hello', $sig));
    assert(!verify($key->publicKey(), 'hellO', $sig));

    // the seed alone brings the same key back
    SigningKey $again = guard SigningKey::restore($key->seed());

    assert($again->publicKey() == $key->publicKey());
    assert($again->sign('hello') == $sig);
}

test ed25519_restore_does_not_touch_the_seed
{
    string $seed = raw('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60');
    SigningKey $key = guard SigningKey::restore($seed);

    assert(hex($seed) == '9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60');
    assert($key->seed() == $seed);
}

test ed25519_rejects_wrong_sizes
{
    SigningKey $key = guard SigningKey::generate();
    string $sig = $key->sign('m');

    assert(SigningKey::restore('short') == null);
    assert(!verify('short', 'm', $sig));
    assert(!verify($key->publicKey(), 'm', $sig->sub(0, 63)->clone()));
}

test ed25519_rejects_flipped_signature_bits
{
    SigningKey $key = guard SigningKey::generate();
    string $sig = $key->sign('m');
    usize $i = 0;

    while ($i < 64) {
        assert(!verify($key->publicKey(), 'm', flipped($sig, $i)));
        $i = $i + 1;
    }
}
