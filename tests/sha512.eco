use crypto::{sha512, hmacSha512, hex};

// FIPS 180-2 "abc" and RFC 4231 test case 2

test sha512_abc
{
    assert(hex(sha512('abc')) == 'ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f');
}

test hmac_sha512_rfc4231_case_2
{
    assert(hex(hmacSha512('Jefe', 'what do ya want for nothing?')) == '164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737');
}
