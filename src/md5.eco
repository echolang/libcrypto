/**
 * MD5 (RFC 1321), one-shot and incremental.
 *
 * MD5 is thoroughly broken for collisions. It's here for checksums, ETags
 * and the protocols that insist on it, never for anything an attacker gets
 * to choose.
 */

namespace crypto;

/**
 * The MD5 chaining state. It sits above `Md5` because a struct's
 * conformance is only seen from below its declaration.
 */
internal struct Md5State : Compressor
{
    // floor(abs(sin(i + 1)) * 2^32)
    internal static array<uint32> $k = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ];

    // left rotate amounts, one row of four per round
    internal static array<uint32> $s = [
        7 as uint32, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ];

    private fixed_array<uint32, 4> $h;

    public constructor()
    {
        $this->h[0] = 0x67452301;
        $this->h[1] = 0xefcdab89;
        $this->h[2] = 0x98badcfe;
        $this->h[3] = 0x10325476;
    }

    public const function digest() : string
    {
        $out = '';
        usize $i = 0;

        $out->reserve(16);

        while ($i < 4) {
            pushLE($out, $this->h[$i] as uint64, 4);
            $i = $i + 1;
        }

        return $out;
    }

    public function compress(const string& $block, usize $at) : void
    {
        fixed_array<uint32, 4>& $h = $this->h;
        const array<uint32>& $k = Md5State::$k;
        const array<uint32>& $s = Md5State::$s;
        fixed_array<uint32, 16> $m;
        usize $t = 0;

        while ($t < 16) {
            $m[$t] = readLE($block, $at + $t * 4, 4) as uint32;
            $t = $t + 1;
        }

        uint32 $a = $h[0];
        uint32 $b = $h[1];
        uint32 $c = $h[2];
        uint32 $d = $h[3];

        $t = 0;

        while ($t < 64) {
            uint32 $f = 0;
            usize $g = 0;

            // four rounds of sixteen, each with its own mixing function and word order
            if ($t < 16) {
                $f = ($b & $c) | ((~$b) & $d);
                $g = $t;
            } else if ($t < 32) {
                $f = ($d & $b) | ((~$d) & $c);
                $g = (5 * $t + 1) % 16;
            } else if ($t < 48) {
                $f = $b ^ $c ^ $d;
                $g = (3 * $t + 5) % 16;
            } else {
                $f = $c ^ ($b | (~$d));
                $g = (7 * $t) % 16;
            }

            $f = $f + $a + $k[$t] + $m[$g];
            $a = $d;
            $d = $c;
            $c = $b;
            $b = $b + rotl($f, $s[$t]);
            $t = $t + 1;
        }

        $h[0] = $h[0] + $a;
        $h[1] = $h[1] + $b;
        $h[2] = $h[2] + $c;
        $h[3] = $h[3] + $d;
    }
}

/**
 * An incremental MD5. Feed it with `update` as often as you like, then
 * `finish` hands back the 16 raw digest bytes and resets the hasher, so the
 * same value can hash the next message.
 */
public class Md5 : Hasher
{
    private Blocks<Md5State> $blocks;

    public constructor()
    {
        $this->blocks = Blocks<Md5State>(Md5State(), true);
    }

    /**
     * Appends `$data` to the message.
     */
    public function update(const string& $data) : void
    {
        $this->blocks->update($data);
    }

    /**
     * Pads the message and returns the digest as 16 raw bytes. The hasher
     * starts over afterwards.
     */
    public function finish() : string
    {
        return $this->blocks->finish();
    }
}

/**
 * The MD5 digest of `$data`, as its 16 raw bytes.
 */
public function md5(const string& $data) : string
{
    $hasher = Md5();

    $hasher->update($data);
    return $hasher->finish();
}
