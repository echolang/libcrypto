/**
 * Password hashing with Argon2id (RFC 9106). `hashPassword` gives you one
 * string to store, `verifyPassword` checks a login against it.
 *
 * The string is the PHC format every Argon2 implementation reads,
 * `$argon2id$v=19$m=65536,t=3,p=1$<salt>$<hash>`, and exactly what PHP's
 * password_hash(PASSWORD_ARGON2ID) writes. A table filled by PHP verifies
 * here and the other way round.
 */

namespace crypto;

public enum PasswordError
{
    /**
     * The operating system would not hand out a salt.
     */
    case noRandomness(RandomError $cause);

    /**
     * There was not enough memory for the work area the cost asked for.
     */
    case outOfMemory;

    /**
     * The cost is outside what Argon2 allows or what this module is
     * willing to spend: memory 8 KiB to 4 GiB, passes 1 to 64, lanes 1
     * to 16, and memory at least 8 KiB per lane.
     */
    case badCost;
}

/**
 * How expensive one hash is. Memory is in KiB, and it is what makes GPUs
 * and custom hardware pay, so raise that first. Lanes are recorded in the
 * hash but computed on one thread here.
 */
public struct PasswordCost
{
    public uint32 $memory;
    public uint32 $passes;
    public uint32 $lanes = 1;

    /**
     * 64 MiB and 3 passes, RFC 9106's second recommendation on a single lane.
     * Around a tenth of a second on a laptop, which is right for a login.
     */
    public static function standard() : PasswordCost
    {
        return PasswordCost(65536, 3);
    }
}

private const SALT_BYTES = 16;
private const HASH_BYTES = 32;

/**
 * The encoded Argon2id hash of `$password` at `$cost`, the standard one
 * unless you pick another, with a fresh random salt. Store the whole string.
 */
public function hashPassword(const string& $password, PasswordCost $cost = .standard()) : result<string, PasswordError>
{
    if (!acceptable($cost)) {
        return .error(.badCost);
    }

    $salt = guard random(SALT_BYTES) else ($e) {
        return .error(.noRandomness($e));
    }

    $hash = guard argon2id($password, $salt, HASH_BYTES, $cost) else {
        return .error(.outOfMemory);
    }

    $out = "$argon2id$v=19$m={$cost->memory},t={$cost->passes},p={$cost->lanes}$";

    $out->append(base64($salt));
    $out->append('$');
    $out->append(base64($hash));
    return .ok($out);
}

/**
 * Whether `$password` is the one `$encoded` was made from. Anything that is
 * not a well formed Argon2id hash, or asks for a cost outside the limits in
 * `PasswordError::badCost`, is simply a no.
 */
public function verifyPassword(const string& $password, const string& $encoded) : bool
{
    $phc = guard parse($encoded) else {
        return false;
    }

    $hash = guard argon2id($password, $phc->salt, $phc->hash->size(), $phc->cost) else {
        return false;
    }

    return equal($hash, $phc->hash);
}

/**
 * Whether `$encoded` was made at a cost other than `$cost`, which is your
 * cue to hash the password again after a successful login. A string that
 * does not parse needs rehashing too.
 */
public function needsRehash(const string& $encoded, PasswordCost $cost = .standard()) : bool
{
    $phc = guard parse($encoded) else {
        return true;
    }

    return $phc->cost->memory != $cost->memory
        || $phc->cost->passes != $cost->passes
        || $phc->cost->lanes != $cost->lanes
        || $phc->salt->size() != SALT_BYTES
        || $phc->hash->size() != HASH_BYTES;
}

private struct Phc
{
    internal PasswordCost $cost;
    internal string $salt;
    internal string $hash;
}

private function acceptable(const PasswordCost& $cost) : bool
{
    return $cost->lanes >= 1 && $cost->lanes <= 16
        && $cost->passes >= 1 && $cost->passes <= 64
        && $cost->memory >= 8 * $cost->lanes && $cost->memory <= 4194304;
}

private function argon2id(const string& $password, const string& $salt, usize $size, const PasswordCost& $cost) : string?
{
    $out = '';
    $p = room($out, $size);

    int32 $rc = c_argon2id($p, $size as uint32, $password->data(), $password->size() as uint32, $salt->data(), $salt->size() as uint32, $cost->memory, $cost->passes, $cost->lanes);

    if ($rc != 0) {
        return null;
    }

    $out->commit($size);
    return $out;
}

/**
 * `$argon2id$v=19$m=..,t=..,p=..$salt$hash` taken apart, or null when any
 * piece is missing, malformed or out of bounds.
 */
private function parse(const string& $encoded) : Phc?
{
    $parts = str::split($encoded, '$')->owned();

    if ($parts->count() != 6 || !$parts[0]->empty() || $parts[1] != 'argon2id' || $parts[2] != 'v=19') {
        return null;
    }

    $params = str::split($parts[3], ',')->owned();

    if ($params->count() != 3) {
        return null;
    }

    uint32 $m = guard param($params[0], 'm=') else { return null; }
    uint32 $t = guard param($params[1], 't=') else { return null; }
    uint32 $p = guard param($params[2], 'p=') else { return null; }
    $cost = PasswordCost($m, $t, $p);

    if (!acceptable($cost)) {
        return null;
    }

    $salt = guard unbase64($parts[4]) else { return null; }
    $hash = guard unbase64($parts[5]) else { return null; }

    if ($salt->size() < 8 || $salt->size() > 64 || $hash->size() < 16 || $hash->size() > 64) {
        return null;
    }

    return Phc($cost, $salt, $hash);
}

/**
 * The number after `$prefix` in `$text`, digits only, at most nine of them.
 */
private function param(const string& $text, const string& $prefix) : uint32?
{
    if (!$text->starts($prefix) || $text->size() == $prefix->size() || $text->size() > $prefix->size() + 9) {
        return null;
    }

    uint32 $n = 0;
    usize $i = $prefix->size();

    while ($i < $text->size()) {
        uint8 $c = $text->byte($i);

        if ($c < 48 || $c > 57) {
            return null;
        }

        $n = $n * 10 + (($c - 48) as uint32);
        $i = $i + 1;
    }

    return $n;
}

/**
 * Standard base64 without padding, the way PHC strings spell bytes.
 */
private function base64(const string& $raw) : string
{
    $alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    $out = '';
    usize $i = 0;

    $out->reserve(($raw->size() * 4 + 2) / 3);

    while ($i < $raw->size()) {
        usize $left = $raw->size() - $i;
        uint32 $n = ($raw->byte($i) as uint32) << 16;

        if ($left > 1) {
            $n = $n | (($raw->byte($i + 1) as uint32) << 8);
        }

        if ($left > 2) {
            $n = $n | ($raw->byte($i + 2) as uint32);
        }

        $out->push($alphabet->byte((($n >> 18) & 63) as usize));
        $out->push($alphabet->byte((($n >> 12) & 63) as usize));

        if ($left > 1) {
            $out->push($alphabet->byte((($n >> 6) & 63) as usize));
        }

        if ($left > 2) {
            $out->push($alphabet->byte(($n & 63) as usize));
        }

        $i = $i + 3;
    }

    return $out;
}

/**
 * The bytes spelled by unpadded standard base64, or null. Leftover bits in
 * the last character must be zero, so every byte string has exactly one
 * spelling.
 */
private function unbase64(const string& $text) : string?
{
    if ($text->size() % 4 == 1) {
        return null;
    }

    $out = '';
    uint32 $acc = 0;
    uint32 $bits = 0;
    usize $i = 0;

    $out->reserve($text->size() * 3 / 4);

    while ($i < $text->size()) {
        int32 $v = sextet($text->byte($i));

        if ($v < 0) {
            return null;
        }

        $acc = ($acc << 6) | ($v as uint32);
        $bits = $bits + 6;

        if ($bits >= 8) {
            $bits = $bits - 8;
            $out->push((($acc >> $bits) & 255) as uint8);
        }

        $i = $i + 1;
    }

    if (($acc & ((1 << $bits) - 1)) != 0) {
        return null;
    }

    return $out;
}

private function sextet(uint8 $c) : int32
{
    if ($c >= 65 && $c <= 90) {
        return ($c as int32) - 65;
    }

    if ($c >= 97 && $c <= 122) {
        return ($c as int32) - 71;
    }

    if ($c >= 48 && $c <= 57) {
        return ($c as int32) + 4;
    }

    if ($c == 43) {
        return 62;
    }

    if ($c == 47) {
        return 63;
    }

    return -1;
}
